# Gmail SMTP credentials used by the contact form (src/app/actions/contact.ts)
# GMAIL_USER: the sending/receiving Gmail address (e.g. djelisprod@gmail.com)
# GMAIL_APP_PASSWORD: a 16-character app password, not the account password —
# generate one at https://myaccount.google.com/apppasswords (requires 2-Step
# Verification enabled on the account).
GMAIL_USER=
GMAIL_APP_PASSWORD=
